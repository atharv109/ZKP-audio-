pragma circom 2.0.0;

include "../node_modules/circomlib/circuits/comparators.circom";
include "../node_modules/circomlib/circuits/bitify.circom";
include "../node_modules/circomlib/circuits/poseidon.circom";

// ─────────────────────────────────────────────────────────────────────────────
// ProvenanceCheckV4 (per FIX_DESIGN.md rev-2; design only changes vs v3):
//   - salt (PRIVATE) + session_nonce + 10 policy bounds (PUBLIC inputs)
//   - C = Poseidon(device_id, timestamp, sensor_score, gps_lat, gps_long, salt)
//     as a PUBLIC OUTPUT (verifier checks proof-C == record-C)
//   - the five v3 rules keep their comparator bit-widths but take PUBLIC bounds
//   - publicSignals order (snarkjs: outputs first, then public inputs in
//     declaration order):
//     [valid, C, media_hash_hi, media_hash_lo, valid_claim, session_nonce,
//      allowed_device_0, allowed_device_1, allowed_device_2,
//      timestamp_min, timestamp_max,
//      gps_lat_min, gps_lat_max, gps_long_min, gps_long_max, sensor_min]
//     = 16 signals (nPublic = 16)
// Metadata TRUTH rests on the issuer (it sees plaintext at enrollment);
// ZK provides verifier-side privacy + verifier-chosen policies after enrollment.
// salt is generated by the ISSUER, handed privately to the holder; policy
// bounds are chosen by the VERIFIER per verification.
// ─────────────────────────────────────────────────────────────────────────────

template ProvenanceCheckV4() {

    // ── Private (witness — never revealed) ───────────────────────────────────
    signal input device_id;
    signal input timestamp;
    signal input sensor_score;
    signal input gps_lat;
    signal input gps_long;     // absolute value of longitude
    signal input salt;         // random field element, issuer-generated

    // ── Public inputs ────────────────────────────────────────────────────────
    signal input media_hash_hi;
    signal input media_hash_lo;
    signal input valid_claim;
    signal input session_nonce;          // 0 = no session binding
    signal input allowed_device_0;
    signal input allowed_device_1;
    signal input allowed_device_2;
    signal input timestamp_min;
    signal input timestamp_max;
    signal input gps_lat_min;
    signal input gps_lat_max;
    signal input gps_long_min;
    signal input gps_long_max;
    signal input sensor_min;

    // ── Public outputs ───────────────────────────────────────────────────────
    signal output valid;
    signal output C;                     // metadata commitment

    // ── Hash limb range constraints (unchanged from v3) ──────────────────────
    component hi_bits = Num2Bits(128);
    hi_bits.in <== media_hash_hi;
    component lo_bits = Num2Bits(128);
    lo_bits.in <== media_hash_lo;

    // ── Metadata commitment C = Poseidon(m1..m5, salt) ──────────────────────
    component pose = Poseidon(6);
    pose.inputs[0] <== device_id;
    pose.inputs[1] <== timestamp;
    pose.inputs[2] <== sensor_score;
    pose.inputs[3] <== gps_lat;
    pose.inputs[4] <== gps_long;
    pose.inputs[5] <== salt;
    C <== pose.out;

    // ── CHECK 1 — device in verifier-chosen 3-slot allow-list ───────────────
    component eq0 = IsEqual();
    eq0.in[0] <== device_id; eq0.in[1] <== allowed_device_0;
    component eq1 = IsEqual();
    eq1.in[0] <== device_id; eq1.in[1] <== allowed_device_1;
    component eq2 = IsEqual();
    eq2.in[0] <== device_id; eq2.in[1] <== allowed_device_2;
    signal device_ok;
    device_ok <== eq0.out + eq1.out + eq2.out;

    // ── CHECK 2 — timestamp in verifier-chosen range (n = 31 as v3) ─────────
    component ts_lo = GreaterEqThan(31);
    ts_lo.in[0] <== timestamp; ts_lo.in[1] <== timestamp_min;
    component ts_hi = LessEqThan(31);
    ts_hi.in[0] <== timestamp; ts_hi.in[1] <== timestamp_max;
    signal ts_ok;
    ts_ok <== ts_lo.out * ts_hi.out;

    // ── CHECK 3 — sensor_score >= verifier-chosen sensor_min (n = 8) ────────
    component score_ge = GreaterEqThan(8);
    score_ge.in[0] <== sensor_score; score_ge.in[1] <== sensor_min;

    // ── CHECK 4 — gps_lat in verifier-chosen range (n = 19 as v3) ───────────
    component lat_lo = GreaterEqThan(19);
    lat_lo.in[0] <== gps_lat; lat_lo.in[1] <== gps_lat_min;
    component lat_hi = LessEqThan(19);
    lat_hi.in[0] <== gps_lat; lat_hi.in[1] <== gps_lat_max;
    signal lat_ok;
    lat_ok <== lat_lo.out * lat_hi.out;

    // ── CHECK 5 — gps_long(abs) in verifier-chosen range (n = 20 as v3) ─────
    component lon_lo = GreaterEqThan(20);
    lon_lo.in[0] <== gps_long; lon_lo.in[1] <== gps_long_min;
    component lon_hi = LessEqThan(20);
    lon_hi.in[0] <== gps_long; lon_hi.in[1] <== gps_long_max;
    signal lon_ok;
    lon_ok <== lon_lo.out * lon_hi.out;

    // ── Final: AND of all five checks (degree-2 chain, as v3) ───────────────
    signal step1; step1 <== device_ok * ts_ok;
    signal step2; step2 <== step1 * score_ge.out;
    signal step3; step3 <== step2 * lat_ok;
    valid <== step3 * lon_ok;

    // claim must match reality (as v3)
    valid_claim === valid;
}

component main {public [media_hash_hi, media_hash_lo, valid_claim, session_nonce,
                     allowed_device_0, allowed_device_1, allowed_device_2,
                     timestamp_min, timestamp_max, gps_lat_min, gps_lat_max,
                     gps_long_min, gps_long_max, sensor_min]} = ProvenanceCheckV4();
